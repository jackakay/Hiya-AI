{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Voice Bug extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/extension",
        // Open the app under test, not the repo: VS Code won't open a folder that is
        // already open in another window. Start Dev Server still runs from the repo root.
        "${workspaceFolder}/demo-app"
      ],
      "outFiles": ["${workspaceFolder}/packages/extension/dist/**/*.js"],
      "preLaunchTask": "build extension"
    }
  ]
}
